APP_NAME=SmartLink
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ──────────────────────────────────────────────────────────────────
# Base de données
# En local : SQLite suffit (`touch database/database.sqlite`), MySQL convient
# aussi. En production sur Vercel : Supabase (PostgreSQL) — voir
# DEPLOY-VERCEL.md. Le code passe sur les trois, la suite de tests est vérifiée
# sur SQLite et sur PostgreSQL.
# ──────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartlink
DB_USERNAME=root
DB_PASSWORD=

# ── Production : Supabase ─────────────────────────────────────────
# Reprendre la chaîne « Transaction pooler » du tableau de bord Supabase, pas
# la connexion directe : en serverless chaque invocation ouvre sa propre
# connexion, et la limite du projet est atteinte en pleine charge. L'hôte du
# pooler contient « pooler » — `deploy:check` le vérifie.
#
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-eu-west-3.pooler.supabase.com
# DB_PORT=6543
# DB_DATABASE=postgres
# DB_USERNAME=postgres.votre-ref-projet
# DB_PASSWORD=
#
# Supabase impose TLS. Le réglage par défaut de Laravel (« prefer ») accepte
# silencieusement une connexion en clair : `deploy:check` le refuse.
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Disque qui porte les fichiers déposés (photos, logos, pièces d'identité).
# « public » convient à un serveur classique. Sur un hébergement serverless au
# système de fichiers éphémère (Vercel), passer à « s3 » : sinon chaque image
# déposée disparaît au déploiement suivant, sans message d'erreur.
MEDIA_DISK=public

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Stockage des fichiers déposés ─────────────────────────────────
# Compatible S3. En production sur Vercel : Supabase Storage, dont les clés
# S3 se créent dans Project Settings → Storage → S3 access keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Supabase et la plupart des stockages compatibles S3 servent le bucket sous
# un chemin, pas un sous-domaine.
AWS_USE_PATH_STYLE_ENDPOINT=false
# Domaine public du bucket, utilisé pour construire les URL des images.
# Indispensable hors S3 d'Amazon. Chez Supabase :
# https://<ref-projet>.supabase.co/storage/v1/object/public/<bucket>
AWS_URL=
# Chez Supabase : https://<ref-projet>.supabase.co/storage/v1/s3
AWS_ENDPOINT=
# « public » pose une ACL sur chaque objet — ce que fait S3 d'Amazon. Supabase
# et Cloudflare R2 ne gèrent pas les ACL par objet : y mettre « private » et
# rendre le bucket public dans leur tableau de bord, sinon chaque dépôt échoue.
AWS_VISIBILITY=public

# ──────────────────────────────────────────────────────────────────
# Tâches planifiées déclenchées par HTTP
# Utile seulement en hébergement serverless, où aucun `schedule:run` ne peut
# tourner en continu (voir DEPLOY-VERCEL.md). Sans ce secret, la route
# /cron/subscriptions-refresh répond 503 : elle refuse plutôt que de s'ouvrir.
# ──────────────────────────────────────────────────────────────────
CRON_SECRET=

# Force le mode « hébergement éphémère » de `php artisan deploy:check` hors
# Vercel (qui, lui, pose VERCEL=1 tout seul). Utile pour vérifier une
# configuration de production depuis sa machine.
# SERVERLESS=true

VITE_APP_NAME="${APP_NAME}"

# ──────────────────────────────────────────────────────────────────
# Couche IA — Claude (Anthropic)
# "rule" n'appelle aucune API et ne coûte rien : mode par défaut, et filet
# vers lequel la plateforme rabat dès qu'un garde-fou se déclenche.
# ──────────────────────────────────────────────────────────────────
AI_DRIVER=rule
ANTHROPIC_API_KEY=
AI_MODEL_CHAT=claude-opus-5
AI_MODEL_WRITING=claude-opus-5
AI_MODEL_SEARCH=claude-haiku-4-5
AI_MODEL_MODERATION=claude-haiku-4-5

# Garde-fous de coût
AI_REQUIRE_AUTH=true
# Fonctions ouvertes aux visiteurs malgré la ligne ci-dessus. La recherche en
# langage naturel en fait partie : c'est elle qui donne envie de s'inscrire.
AI_GUEST_FEATURES=search
# Recherches en langage naturel par jour et par adresse IP, pour les visiteurs.
AI_GUEST_SEARCHES_PER_DAY=10
AI_DAILY_MESSAGES=20
AI_MONTHLY_BUDGET_USD=10
AI_HISTORY_TURNS=6

# ──────────────────────────────────────────────────────────────────
# Abonnements prestataires
# ──────────────────────────────────────────────────────────────────
SUBSCRIPTION_TRIAL_DAYS=30
SUBSCRIPTION_CYCLE_DAYS=30

# ──────────────────────────────────────────────────────────────────
# Mobile Money – HR-Skills Pay (MTN MoMo + Orange Money Cameroun)
# « mock » n'appelle aucune API : mode par défaut, pour développer et tester
# sans compte ni réseau. Y basculer sur « hrskills » en production.
# ──────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=mock

# Authentification à double clé. Les deux doivent porter le MÊME environnement :
# soit les deux en _test_, soit les deux en _live_ (hrsk_pk_live_… avec
# hrsk_sk_live_…). Un mélange enverrait des appels de production authentifiés
# par un secret de test — `php artisan payment:check` le vérifie.
HRSKILLS_CLE_A=
HRSKILLS_CLE_B=

# Sans ce secret, la signature des rappels ne peut pas être vérifiée et
# n'importe qui pourrait déclarer un abonnement réglé. Obligatoire en production.
HRSKILLS_WEBHOOK_SECRET=

HRSKILLS_BASE_URL=https://api.hrskills-pay.com

# ──────────────────────────────────────────────────────────────────
# SMS – Africa's Talking
# Compte : https://africastalking.com  |  Sandbox gratuit disponible
# ──────────────────────────────────────────────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=SmartLink
AT_SANDBOX=true

# Identité de l'éditeur, affichée dans les mentions légales. Ces valeurs
# figurent sur vos statuts : tant qu'elles sont vides, les pages légales
# affichent un avertissement visible plutôt qu'un texte qui aurait l'air complet.
LEGAL_RAISON_SOCIALE=
LEGAL_FORME_JURIDIQUE=
LEGAL_CAPITAL=
LEGAL_RCCM=
LEGAL_NIU=
LEGAL_SIEGE=
LEGAL_DIRECTEUR_PUBLICATION=
LEGAL_EMAIL=
LEGAL_TELEPHONE=
# À passer à true seulement après relecture par un juriste : le bandeau
# « document non validé » disparaît alors des trois pages.
LEGAL_VALIDE=false

# Photographies distantes (config/imagery.php).
# À vrai, les vignettes de service et le bandeau d'appel aux prestataires
# affichent des photos servies par un hôte extérieur. Ce sont des images de
# calage : leur licence Creative Commons exige une attribution que la page ne
# porte pas, et chaque affichage envoie l'IP du visiteur à ce tiers. Posez
# false en production tant que les URL n'ont pas été remplacées par des images
# dont vous détenez les droits.
REMOTE_IMAGES=true
